{
  "permissions": {},
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lvcas0x1/.config/wezterm/wzsession/hooks/session-id.py claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lvcas0x1/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "aws-core@claude-plugins-official": true,
    "aws-agents@claude-plugins-official": true,
    "aws-data-analytics@claude-plugins-official": true,
    "aws-agents-for-devsecops@agent-toolkit-for-aws": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    }
  },
  "theme": "light",
  "agentPushNotifEnabled": true
}
